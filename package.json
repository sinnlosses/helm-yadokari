{
  "name": "helm-yadokari",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/index.js",
    "dev": "tsx --env-file=.env src/index.ts",
    "lint": "oxlint src scripts && pnpm lint:validate-config",
    "lint:fix": "oxlint src scripts --fix",
    "lint:validate-config": "tsx scripts/lint/validate-config.ts",
    "lint:validate-config:remote": "tsx --env-file-if-exists=.env scripts/lint/validate-config.ts --remote",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm tsc --noEmit && pnpm lint && pnpm format:check && pnpm test"
  },
  "dependencies": {
    "@gitbeaker/rest": "^43.8.0",
    "p-limit": "^7.3.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/coverage-v8": "^4.1.0",
    "oxfmt": "^0.52.0",
    "oxlint": "^1.67.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@11.5.1"
}
