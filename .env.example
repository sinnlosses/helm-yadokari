# 管理対象のchart/ソースリポジトリが置かれているプラットフォーム（任意、gitlab または github、デフォルト: gitlab）
# PLATFORM=gitlab

# GitLab インスタンスの URL（PLATFORM=gitlab のとき必須）
GITLAB_URL=https://gitlab.example.com

# GitHub REST APIのエンドポイントURL（PLATFORM=github のとき必須。github.comなら https://api.github.com、GHESなら https://<host>/api/v3）
# GITHUB_URL=https://api.github.com

# タグ取得・ファイル更新・MR作成権限を持つトークン（必須）
# PLATFORM=gitlab なら Group/Project Access Token、PLATFORM=github なら Personal Access Token（fine-grained推奨。GitHub側はこの形式のみサポート）
ACCESS_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# 設定ディレクトリのパス（任意、デフォルト: config/）
# CONFIG_ROOT_PATH=config/

# (chartリポジトリ, 設定ユニット)単位の同時処理数（任意、1〜20の整数、デフォルト: 3）
# CONCURRENCY_LIMIT=3

# true のときタグ作成・ブランチ作成・MR作成をスキップし、更新予定の内容のみログ出力する（任意、デフォルト: false）
# DRY_RUN=false

# 特定のchartディレクトリのみ対象にする（任意、省略時は全chart）
# TARGET_CHART=teamA-chart

# 特定の設定ユニットのみ対象にする（任意、省略時は全設定ユニット）
# unitPath（深さ1なら "central"、深さ2なら "tenant1/client1"）。カンマ区切りで複数指定できる
# TARGET_UNITS=tenant1/client1,tenant2/client2
