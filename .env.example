# GitLab インスタンスの URL（必須）
GITLAB_URL=https://gitlab.example.com

# タグ取得・ファイル更新・MR作成権限を持つ Group/Project Access Token（必須）
ACCESS_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# 設定ディレクトリのパス（任意、デフォルト: config/）
# CONFIG_PATH=config/

# (chartリポジトリ, テナント/クライアント)単位の同時処理数（任意、1〜20の整数、デフォルト: 3）
# CONCURRENCY_LIMIT=3

# true のときタグ作成・ブランチ作成・MR作成をスキップし、更新予定の内容のみログ出力する（任意、デフォルト: false）
# DRY_RUN=false

# 特定のchartディレクトリのみ対象にする（任意、省略時は全chart）
# TARGET_CHART=teamA-chart

# 特定のtenant/clientのみ対象にする（任意、省略時は全client）
# "<tenantId>/<clientId>" 形式。カンマ区切りで複数指定できる
# TARGET_CLIENTS=tenantId1/clientId1,tenantId2/clientId2

# タグ命名規則のテンプレート。{branch}/{date}/{time} プレースホルダをちょうど1回ずつ含める
# （任意、デフォルト: "{branch}-build-at-{date}-{time}"）
# TAG_FORMAT={branch}-build-at-{date}-{time}
